---
import ProjectCard from "./ProjectCard.astro";
import BlogHeader from "./BlogHeader.astro";
import ProfilePanel from "./ProfilePanel.astro";
import { getProjects } from "../lib/projects";

interface Props {
  content: any;
  lang: "en" | "ko";
}

const { content, lang } = Astro.props;
const homeHref = lang === "ko" ? "/ko/" : "/";
const projects = getProjects(content);
const welcome = "WELCOME TO HARIM'S PAGE.";
const introductionLead =
  lang === "ko"
    ? "현실을 벡터화하고, 예측하고, 불확실성을 추정하는 것에 관심이 있습니다."
    : "I am interested in vectorizing reality, making predictions, and estimating uncertainty.";
---

<BlogHeader homeHref={homeHref} lang={lang} />

<main id="top">
  <div class="home-layout shell">
    <ProfilePanel lang={lang} />

    <div class="home-content">
      <section class="blog-intro" aria-labelledby="blog-intro-title">
        <div class="intro-copy">
          <h1 id="blog-intro-title">{welcome}</h1>
          <p>{introductionLead}</p>
        </div>
      </section>

      <section id="projects" class="section projects-section">
        <div class="project-list">
          {projects.map((project: any) => (
            <ProjectCard
              project={project}
              topic={project.topic}
              lang={lang}
              slug={project.slug}
            />
          ))}
        </div>
      </section>
    </div>
  </div>
</main>
