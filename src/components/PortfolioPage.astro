---
import ProjectCard from "./ProjectCard.astro";
import BlogHeader from "./BlogHeader.astro";
import ProfilePanel from "./ProfilePanel.astro";
import { getProjects } from "../lib/projects";

interface Props {
  content: any;
  lang: "en" | "ko";
}

const { content, lang } = Astro.props;
const homeHref = lang === "ko" ? "/ko/" : "/";
const homepageHiddenProjectSlugs = new Set(["probabilistic-bid-mlops", "document-ai-ocr"]);
const projects = getProjects(content).filter(
  (project: any) => !homepageHiddenProjectSlugs.has(project.slug),
);
const welcome = "WELCOME TO HARIM'S PAGE.";
---

<BlogHeader homeHref={homeHref} lang={lang} />

<main id="top">
  <div class="home-layout shell">
    <ProfilePanel lang={lang} />

    <div class="home-content">
      <section class="blog-intro" aria-labelledby="blog-intro-title">
        <div class="intro-copy">
          <h1 id="blog-intro-title">{welcome}</h1>
          <p class="intro-support">{content.hero.body}</p>
        </div>
        <div class="highlights" aria-labelledby="highlights-title">
          <h2 id="highlights-title">{lang === "ko" ? "핵심 성과" : "Highlights"}</h2>
          <ul>
            {content.hero.highlights.map((item: { title: string; detail: string; href: string }) => (
              <li>
                <a href={item.href}>{item.title}</a>
                <p>{item.detail}</p>
              </li>
            ))}
          </ul>
        </div>
        <div class="competencies" aria-labelledby="competencies-title">
          <h2 id="competencies-title">{lang === "ko" ? "핵심 역량" : "Core Strengths"}</h2>
          <dl>
            {content.hero.competencies.map(([title, description]: [string, string]) => (
              <div><dt>{title}</dt><dd>{description}</dd></div>
            ))}
          </dl>
        </div>
      </section>

      <section id="projects" class="section projects-section">
        <div class="project-list">
          {projects.map((project: any) => (
            <ProjectCard
              project={project}
              topic={project.topic}
              lang={lang}
              slug={project.slug}
            />
          ))}
        </div>
      </section>
    </div>
  </div>
</main>

<style>
  .competencies { margin-top: 32px; }
  .competencies h2 { margin: 0 0 16px; font-size: 0.85rem; color: var(--muted); }
  .competencies dl { display: grid; gap: 18px; margin: 0; }
  .competencies dt { font-size: 1rem; font-weight: 600; }
  .competencies dd { margin: 5px 0 0; font-size: 0.9rem; line-height: 1.7; color: var(--muted); word-break: keep-all; }
  .highlights { margin-top: 28px; }
  .highlights h2 { margin: 0 0 16px; font-size: 0.85rem; color: var(--muted); }
  .highlights ul { display: grid; gap: 18px; margin: 0; padding: 0; list-style: none; }
  .highlights a { font-size: 1rem; font-weight: 600; word-break: keep-all; }
  .highlights a:hover { color: var(--accent-ink); }
  .highlights a:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
  .highlights p { margin: 5px 0 0; font-size: 0.85rem; line-height: 1.6; color: var(--muted); }
</style>
