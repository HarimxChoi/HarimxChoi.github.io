---
import ProjectCard from "./ProjectCard.astro";
import BlogHeader from "./BlogHeader.astro";
import ProfilePanel from "./ProfilePanel.astro";
import { getProjects } from "../lib/projects";

interface Props {
  content: any;
  lang: "en" | "ko";
}

const { content, lang } = Astro.props;
const homeHref = lang === "ko" ? "/ko/" : "/";
const projects = getProjects(content);
const welcome = "WELCOME TO HARIM'S PAGE.";
const introductionLead =
  lang === "ko"
    ? "현실을 벡터화하고, 예측하고, 불확실성을 추정하는 머신러닝 엔지니어입니다."
    : "I am a machine learning engineer focused on vectorizing reality, making predictions, and estimating uncertainty.";
const introductionSupport =
  lang === "ko"
    ? "7년 동안 공공조달·건설·리테일 데이터에서 Tabular ML, NLP, Computer Vision과 LLM Agent를 데이터 수집부터 평가·배포까지 연결해 왔습니다. 낯선 도메인에서도 무엇을 예측할지와 결과를 어디까지 믿고 쓸 수 있을지부터 정의하고, 성능·비용·운영 제약 안에서 실제 쓰이는 시스템으로 구현합니다."
    : "Over seven years, I have connected tabular ML, NLP, computer vision, and LLM agents from data collection through evaluation and deployment across public procurement, construction, and retail. In unfamiliar domains, I first define what to predict and how far the result can be trusted, then build systems within performance, cost, and operational constraints.";
---

<BlogHeader homeHref={homeHref} lang={lang} />

<main id="top">
  <div class="home-layout shell">
    <ProfilePanel lang={lang} />

    <div class="home-content">
      <section class="blog-intro" aria-labelledby="blog-intro-title">
        <div class="intro-copy">
          <h1 id="blog-intro-title">{welcome}</h1>
          <p>{introductionLead}</p>
          <p class="intro-support">{introductionSupport}</p>
        </div>
      </section>

      <section id="projects" class="section projects-section">
        <div class="project-list">
          {projects.map((project: any) => (
            <ProjectCard
              project={project}
              topic={project.topic}
              lang={lang}
              slug={project.slug}
            />
          ))}
        </div>
      </section>
    </div>
  </div>
</main>
