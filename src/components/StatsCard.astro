---
interface Props {
  lang?: "en" | "ko";
}
const { lang = "en" } = Astro.props;

const copy = {
  en: {
    eyebrow: "selected signals",
    stats: [
      ["7+ yrs", "applied ML and workflow automation"],
      ["50% → 90%", "OCR accuracy · internal measure"],
      ["136s → 25s", "vectorized inference · internal benchmark"],
      ["278 stars", "google-surf-mcp · 33 forks · 2026-08-12"],
    ],
  },
  ko: {
    eyebrow: "대표 신호",
    stats: [
      ["7년+", "Applied ML과 업무 자동화"],
      ["50% → 90%", "OCR 정확도 · 내부 측정 기준"],
      ["136초 → 25초", "vectorized inference · 내부 benchmark"],
      ["278 stars", "google-surf-mcp · 33 forks · 2026-08-12"],
    ],
  },
};

const c = copy[lang];
---

<aside class="col-span-12 md:col-span-4 rounded-2xl border border-orange-400/40 bg-orange-500/[0.08] p-8 md:p-10 flex flex-col gap-6">
  <div class="text-xs font-mono uppercase tracking-[0.2em] text-orange-400">
    {c.eyebrow}
  </div>
  <dl class="flex flex-col gap-5">
    {c.stats.map(([n, label]) => (
      <div class="flex flex-col gap-1">
        <dt class="text-3xl md:text-4xl font-bold tracking-tight tabular-nums">{n}</dt>
        <dd class="text-xs font-mono text-zinc-400">{label}</dd>
      </div>
    ))}
  </dl>
</aside>
