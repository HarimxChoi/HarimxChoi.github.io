---
const lang = Astro.props.lang ?? "en";
const label = lang === "ko" ? "색상 모드 전환" : "Toggle color mode";
---

<button id="theme-toggle" class="theme-toggle" type="button" aria-label={label}>
  <svg class="theme-icon" data-light viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="12" cy="12" r="3.5"></circle>
    <path d="M12 2v2.2M12 19.8V22M4.9 4.9l1.6 1.6M17.5 17.5l1.6 1.6M2 12h2.2M19.8 12H22M4.9 19.1l1.6-1.6M17.5 6.5l1.6-1.6"></path>
  </svg>
  <svg class="theme-icon" data-dark viewBox="0 0 24 24" aria-hidden="true">
    <path d="M20 15.2A8.3 8.3 0 0 1 8.8 4a8.3 8.3 0 1 0 11.2 11.2Z"></path>
  </svg>
</button>

<script is:inline>
  (function () {
    var button = document.getElementById("theme-toggle");
    if (!button) return;
    var sync = function () {
      var dark = document.documentElement.dataset.theme === "dark";
      button.setAttribute("aria-pressed", String(dark));
    };
    sync();
    button.addEventListener("click", function () {
      var next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
      document.documentElement.dataset.theme = next;
      try { localStorage.setItem("portfolio-theme", next); } catch (error) {}
      sync();
    });
  })();
</script>
