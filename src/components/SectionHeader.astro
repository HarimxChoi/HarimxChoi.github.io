---
interface Props {
  number: string;
  eyebrow: string;
  title: string;
  body?: string;
}

const { number, eyebrow, title, body } = Astro.props;
---

<header class="section-heading">
  <div class="section-index">{number}</div>
  <div>
    <p class="eyebrow">{eyebrow}</p>
    <h2>{title}</h2>
    {body && <p class="section-copy">{body}</p>}
  </div>
</header>
