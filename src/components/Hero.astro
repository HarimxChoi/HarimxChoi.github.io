---
interface Props {
  lang?: "en" | "ko";
}
const { lang = "en" } = Astro.props;

const links = [
  { label: "github", href: "https://github.com/HarimxChoi" },
  { label: "linkedin", href: "https://www.linkedin.com/in/harimxchoi" },
  { label: "email", href: "mailto:2.harim.choi@gmail.com" },
];

const copy = {
  en: {
    eyebrow: "Seoul",
    name1: "Harim",
    name2: "Choi.",
    body: "I build reliable decision systems for real-world ML, where data are incomplete, models are uncertain, and actions have consequences. For more than seven years, I have connected data collection, modeling, evaluation, APIs, batch deployment, and operating controls across probabilistic and tabular ML, NLP, computer vision, and LLM agents.",
    anchor: "Applied machine learning · reliable decision systems.",
    stack: [
      "Python · TypeScript · PyTorch",
      "Tabular / Probabilistic ML · NLP · CV",
      "MCP · LangGraph · RAG / Retrieval",
      "Calibration · UQ · ONNX · FastAPI",
    ],
  },
  ko: {
    eyebrow: "서울",
    name1: "최하림",
    name2: "",
    body: "불완전한 데이터와 불확실한 모델을 신뢰할 수 있는 의사결정 시스템으로 바꾸는 머신러닝 엔지니어입니다. 7년 이상 tabular·probabilistic ML, NLP, Computer Vision과 LLM agent를 다루며 데이터 수집부터 모델링·평가·API와 배치 운영까지 직접 연결해 왔습니다.",
    anchor: "Applied machine learning · reliable decision systems.",
    stack: [
      "Python · TypeScript · PyTorch",
      "Tabular / Probabilistic ML · NLP · CV",
      "MCP · LangGraph · RAG / Retrieval",
      "Calibration · UQ · ONNX · FastAPI",
    ],
  },
};

const c = copy[lang];
---

<header class="col-span-12 rounded-2xl border border-zinc-800 bg-gradient-to-br from-zinc-900 via-zinc-900 to-zinc-950 p-8 md:p-12">
  <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-8">
    <div class="flex flex-col gap-4 max-w-2xl">
      <div class="text-xs font-mono uppercase tracking-[0.2em] text-orange-400">
        {c.eyebrow}
      </div>
      <h1 class="text-5xl md:text-7xl font-bold tracking-tight leading-[0.95]">
        {c.name1}{c.name2 && <><br/>{c.name2}</>}
      </h1>
      <p class="text-lg md:text-xl text-zinc-300 leading-relaxed">
        {c.body}
      </p>
      <p class="text-base md:text-lg font-mono text-orange-400 mt-1">
        {c.anchor}
      </p>
      <div class="flex flex-wrap gap-3 mt-2">
        {links.map((l) => (
          <a
            href={l.href}
            target="_blank"
            rel="noopener"
            class="font-mono text-xs px-3 py-1.5 rounded-full border border-zinc-700 hover:border-orange-400 hover:text-orange-400 transition-colors"
          >
            {l.label} →
          </a>
        ))}
      </div>
    </div>
    <div class="flex flex-col gap-1 font-mono text-xs text-zinc-400 md:text-right">
      {c.stack.map((s) => <div>{s}</div>)}
    </div>
  </div>
</header>
