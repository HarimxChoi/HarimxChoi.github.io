---
interface Props {
  lang?: "en" | "ko";
}
const { lang = "en" } = Astro.props;

const copy = {
  en: {
    eyebrow: "working pattern",
    title: "One pattern across different domains.",
    facts: [
      ["failure conditions", "Find data leakage, metric errors, domain gaps, and identification limits before trusting a score table."],
      ["decision path", "Connect collection, retrieval or modeling, evaluation, approval, deployment, and recovery rather than stopping at a model endpoint."],
      ["delivery", "Translate unfamiliar workflows into measurable systems while balancing performance, cost, security, and operating constraints."],
    ],
  },
  ko: {
    eyebrow: "업무 방식",
    title: "도메인이 달라도 반복되는 한 가지 패턴.",
    facts: [
      ["실패 조건", "성능표를 믿기 전에 데이터 누수, 잘못된 지표, domain gap과 식별 한계를 먼저 찾습니다."],
      ["의사결정 경로", "수집, 검색·모델링, 평가, 승인, 배포와 복구를 연결해 모델 endpoint에서 끝나지 않게 만듭니다."],
      ["실행", "낯선 workflow를 빠르게 구조화하고 성능·비용·보안·운영 제약을 함께 맞춰 측정 가능한 시스템으로 구현합니다."],
    ],
  },
};

const c = copy[lang];
---

<section class="col-span-12 md:col-span-8 rounded-2xl border border-zinc-800 bg-zinc-900 p-8 md:p-10">
  <div class="flex flex-col gap-6">
    <div>
      <div class="text-xs font-mono uppercase tracking-[0.2em] text-orange-400 mb-3">
        {c.eyebrow}
      </div>
      <h2 class="text-2xl md:text-3xl font-semibold tracking-tight">
        {c.title}
      </h2>
    </div>
    <dl class="grid grid-cols-1 gap-4">
      {c.facts.map(([k, v]) => (
        <div class="flex flex-col md:flex-row md:items-baseline gap-1 md:gap-6 border-t border-zinc-800 pt-3">
          <dt class="font-mono text-xs uppercase tracking-wider text-orange-400 md:w-40 shrink-0">{k}</dt>
          <dd class="text-sm text-zinc-300 leading-relaxed">{v}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>
