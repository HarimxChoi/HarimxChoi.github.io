---
interface Props {
  project: any;
  index: string;
  lang: "en" | "ko";
}

const { project, index, lang } = Astro.props;
const repositoryLabel = lang === "ko" ? "저장소" : "Repository";
const privateLabel = lang === "ko" ? "비공개" : "Private";
---

<article class:list={["project-card", project.image && "project-card--visual"]}>
  {project.image && (
    <figure class="project-media">
      <img src={project.image} alt={project.imageAlt} loading="lazy" />
      {project.imageCaption && <figcaption>{project.imageCaption}</figcaption>}
    </figure>
  )}

  <div class="project-body">
    <div class="project-topline">
      <span class="project-number">{index}</span>
      <span class="period">{project.period}</span>
    </div>

    <div class="project-title-row">
      <div>
        <h4>{project.title}</h4>
        <p class="project-status">{project.status}</p>
      </div>
      {project.href ? (
        <a class="project-link" href={project.href} target="_blank" rel="noopener">
          {repositoryLabel} <span aria-hidden="true">↗</span>
        </a>
      ) : (
        <span class="private-label">{privateLabel}</span>
      )}
    </div>

    <p class="project-summary">{project.summary}</p>

    <div class="project-metric">{project.metric}</div>

    <div class="tag-row category-row" aria-label="Categories">
      {project.categories.map((tag: string) => <span>{tag}</span>)}
    </div>

    <ul class="evidence-list compact">
      {project.bullets.map((bullet: string) => <li>{bullet}</li>)}
    </ul>

    <div class="tool-line">
      {project.tools.map((tool: string) => <span>{tool}</span>)}
    </div>
  </div>
</article>
