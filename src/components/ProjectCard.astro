---
interface Props {
  project: any;
  topic: string;
  lang: "en" | "ko";
  slug: string;
}

const { project, topic, lang, slug } = Astro.props;
const articleHref = lang === "ko" ? `/ko/projects/${slug}/` : `/projects/${slug}/`;
const articleLabel = lang === "ko" ? "읽기" : "Read";
---

<a class:list={["project-card", project.image && "project-card--visual"]} href={articleHref}>
  <span class="project-preview">
    {project.image ? (
      <span class="project-thumbnail">
        <img src={project.image} alt={project.imageAlt} loading="lazy" />
      </span>
    ) : (
      <span class="project-thumbnail project-thumbnail--empty" aria-hidden="true"></span>
    )}

    <span class="project-preview-copy">
      <span class="project-title">{project.title}</span>
      <span class="project-status">{project.status}</span>
      <span class="project-topic">{topic}</span>
      <span class="project-description">{project.summary}</span>
    </span>

    <span class="project-metric">{project.metric}</span>
    <span class="project-action">
      <span class="project-read">{articleLabel} <span aria-hidden="true">→</span></span>
      <span class="project-published">{project.publishedAt} · {project.readingTime}</span>
    </span>
  </span>
</a>
