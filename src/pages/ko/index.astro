---
import Layout from "../../layouts/Layout.astro";
import Hero from "../../components/Hero.astro";
import CareerCard from "../../components/CareerCard.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import AboutCard from "../../components/AboutCard.astro";
import StatsCard from "../../components/StatsCard.astro";
import ThemeSwitcher from "../../components/ThemeSwitcher.astro";
import { careers, projects } from "../../data/portfolio";
---

<Layout
  title="최하림 · Applied Machine Learning Engineer"
  description="불완전한 데이터와 불확실한 모델을 신뢰할 수 있는 의사결정 시스템으로 바꾸는 Applied ML 엔지니어."
  lang="ko"
>
  <ThemeSwitcher lang="ko" />
  <main class="mx-auto max-w-7xl px-4 md:px-8 py-8 md:py-12">
    <div class="grid grid-cols-12 gap-3 md:gap-4">
      <Hero lang="ko" />

      <section class="col-span-12 mt-10 mb-2 flex flex-col gap-3 border-b border-zinc-800 pb-6 md:flex-row md:items-end md:justify-between">
        <div>
          <div class="mb-2 font-mono text-xs uppercase tracking-[0.2em] text-orange-400">경력</div>
          <h2 class="text-3xl font-semibold tracking-tight md:text-5xl">실제 업무 경로까지 연결한 시스템.</h2>
        </div>
        <p class="max-w-xl text-sm leading-relaxed text-zinc-400">
          고용 경력과 독립 프로젝트를 분리했습니다. 각 경력에서 다룬 대분류, 실제 기술과 방법, 운영 환경과 결과 범위를 함께 보여줍니다.
        </p>
      </section>

      {careers.map((career) => (
        <CareerCard
          company={career.company.ko}
          role={career.role.ko}
          period={career.period.ko}
          context={career.context.ko}
          proof={career.proof.ko}
          domains={career.domains}
          methods={career.methods}
          evidence={career.evidence}
          lang="ko"
        />
      ))}

      <section class="col-span-12 mt-12 mb-2 flex flex-col gap-3 border-b border-zinc-800 pb-6 md:flex-row md:items-end md:justify-between">
        <div>
          <div class="mb-2 font-mono text-xs uppercase tracking-[0.2em] text-orange-400">프로젝트 및 연구</div>
          <h2 class="text-3xl font-semibold tracking-tight md:text-5xl">도메인은 달라도 같은 신뢰성 문제.</h2>
        </div>
        <p class="max-w-xl text-sm leading-relaxed text-zinc-400">
          공개 프로젝트는 source로 연결하고, 비공개 작업은 기밀을 제외한 시스템 구조, 평가 범위와 확인 가능한 결과만 설명합니다.
        </p>
      </section>

      {projects.map((project) => (
        <ProjectCard
          title={project.title}
          tagline={project.summary.ko}
          proof={project.proof.ko}
          domains={project.domains}
          methods={project.methods}
          access={project.access}
          evidence={project.evidence}
          href={project.href}
          image={project.image}
          imageAlt={project.imageAlt?.ko}
          stat={project.stat?.ko}
          tone={project.tone}
          lang="ko"
        />
      ))}

      <AboutCard lang="ko" />
      <StatsCard lang="ko" />

      <footer class="col-span-12 mt-8 flex flex-col gap-3 border-t border-zinc-800 pt-6 font-mono text-xs text-zinc-500 md:flex-row md:items-center md:justify-between">
        <div>© 2026 최하림 · 서울 · 2026-08-12 업데이트</div>
        <div class="flex gap-4">
          <a href="https://github.com/HarimxChoi" class="transition-colors hover:text-orange-400">github.com/HarimxChoi</a>
          <a href="mailto:2.harim.choi@gmail.com" class="transition-colors hover:text-orange-400">2.harim.choi@gmail.com</a>
        </div>
      </footer>
    </div>
  </main>
</Layout>
