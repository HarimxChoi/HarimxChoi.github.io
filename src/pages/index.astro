---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import CareerCard from "../components/CareerCard.astro";
import ProjectCard from "../components/ProjectCard.astro";
import AboutCard from "../components/AboutCard.astro";
import StatsCard from "../components/StatsCard.astro";
import ThemeSwitcher from "../components/ThemeSwitcher.astro";
import { careers, projects } from "../data/portfolio";
---

<Layout>
  <ThemeSwitcher lang="en" />
  <main class="mx-auto max-w-7xl px-4 md:px-8 py-8 md:py-12">
    <div class="grid grid-cols-12 gap-3 md:gap-4">
      <Hero lang="en" />

      <section class="col-span-12 mt-10 mb-2 flex flex-col gap-3 border-b border-zinc-800 pb-6 md:flex-row md:items-end md:justify-between">
        <div>
          <div class="mb-2 font-mono text-xs uppercase tracking-[0.2em] text-orange-400">Career systems</div>
          <h2 class="text-3xl font-semibold tracking-tight md:text-5xl">Work that reached an operating workflow.</h2>
        </div>
        <p class="max-w-xl text-sm leading-relaxed text-zinc-400">
          Employment work is separated from independent projects. Each card shows the domain, methods, operating context, and the boundary of its evidence.
        </p>
      </section>

      {careers.map((career) => (
        <CareerCard
          company={career.company.en}
          role={career.role.en}
          period={career.period.en}
          context={career.context.en}
          proof={career.proof.en}
          domains={career.domains}
          methods={career.methods}
          evidence={career.evidence}
          lang="en"
        />
      ))}

      <section class="col-span-12 mt-12 mb-2 flex flex-col gap-3 border-b border-zinc-800 pb-6 md:flex-row md:items-end md:justify-between">
        <div>
          <div class="mb-2 font-mono text-xs uppercase tracking-[0.2em] text-orange-400">Projects and research</div>
          <h2 class="text-3xl font-semibold tracking-tight md:text-5xl">Different domains, the same reliability question.</h2>
        </div>
        <p class="max-w-xl text-sm leading-relaxed text-zinc-400">
          Public repositories link to source. Private work exposes only non-confidential architecture, evaluation boundaries, and reproducible claims.
        </p>
      </section>

      {projects.map((project) => (
        <ProjectCard
          title={project.title}
          tagline={project.summary.en}
          proof={project.proof.en}
          domains={project.domains}
          methods={project.methods}
          access={project.access}
          evidence={project.evidence}
          href={project.href}
          image={project.image}
          imageAlt={project.imageAlt?.en}
          stat={project.stat?.en}
          tone={project.tone}
          lang="en"
        />
      ))}

      <AboutCard lang="en" />
      <StatsCard lang="en" />

      <footer class="col-span-12 mt-8 flex flex-col gap-3 border-t border-zinc-800 pt-6 font-mono text-xs text-zinc-500 md:flex-row md:items-center md:justify-between">
        <div>© 2026 Harim Choi · Seoul · updated 2026-08-12</div>
        <div class="flex gap-4">
          <a href="https://github.com/HarimxChoi" class="transition-colors hover:text-orange-400">github.com/HarimxChoi</a>
          <a href="mailto:2.harim.choi@gmail.com" class="transition-colors hover:text-orange-400">2.harim.choi@gmail.com</a>
        </div>
      </footer>
    </div>
  </main>
</Layout>
